# Copy these settings into the backend .env. Never put OSS secrets in VITE_* variables.
# Use a private bucket and a RAM identity scoped to <bucket>/chat-attachments/*.
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=your-private-bucket
OSS_ACCESS_KEY_ID=your-ram-access-key-id
OSS_ACCESS_KEY_SECRET=your-ram-access-key-secret
# Optional when using temporary STS credentials; refresh all three credentials before expiry.
# OSS_STS_TOKEN=

# Model API keys are entered by each user in Model services.
# Generate once with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Keep this server-side encryption key stable and backed up.
USER_API_KEY_ENCRYPTION_KEY=replace-with-64-hex-characters
