# Local development: simulated email files appear in .local-mail/ (git ignored).
# Copy into .env and restart. Open the URL in the generated JSON email's text.
MAIL_TRANSPORT=json
PASSWORD_RESET_URL=http://localhost:5173/login

# Production: set NODE_ENV=production and replace the above with SMTP settings.
# MAIL_TRANSPORT=smtp
# PASSWORD_RESET_URL=https://your-app.example.com/login
# MAIL_FROM=CuproAgent <noreply@your-app.example.com>
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-user
# SMTP_PASSWORD=your-smtp-password
# For implicit TLS: SMTP_PORT=465 and SMTP_SECURE=true.
